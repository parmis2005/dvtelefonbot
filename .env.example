# Digital Vision Dario - Beispielkonfiguration
# Datei kopieren nach .env und mit echten Werten fuellen.
# NIEMALS die .env Datei committen.

# --- Agent / Unternehmen ---
AGENT_NAME=Dario
COMPANY_NAME=Digital Vision
COMPANY_LOCATION=Moenchengladbach

# --- Provider-Auswahl ---
# Optionen: local_whisper
STT_PROVIDER=local_whisper
# Optionen: local_llama
LLM_PROVIDER=local_llama
# Optionen: local_piper (schnell, klingt synthetischer), chatterbox (langsamer,
# deutlich natuerlichere Stimme - Ergebnis der Stimmauswahl fuer Dario, siehe
# README "Voice-Test starten"; benoetigt Extra "chatterbox", ~2GB Download)
TTS_PROVIDER=chatterbox
# Optionen: asterisk
TELEPHONY_PROVIDER=asterisk
# Optionen: smtp
EMAIL_PROVIDER=smtp
# Optionen: none, meta_cloud_api
WHATSAPP_PROVIDER=none

# --- Datenbank ---
DATABASE_URL=sqlite+aiosqlite:///./data/dario.db

# --- Timeouts / Verhalten (Sekunden) ---
WAIT_TIMEOUT=25
SILENCE_TIMEOUT=8
CALL_COOLDOWN=86400
MAX_REJECTIONS=2

# --- lokales LLM (llama.cpp Server, OpenAI-kompatibel) ---
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_MODEL_NAME=local-model
LLAMA_TIMEOUT=30

# --- Whisper (whisper.cpp) ---
WHISPER_CPP_BINARY=whisper-cli
WHISPER_MODEL_PATH=./models/whisper/ggml-small.bin
WHISPER_LANGUAGE=de

# --- TTS (Piper) ---
# Empfohlene deutsche maennliche Stimmen (siehe README "Voice-Test starten"
# fuer Download-Befehle und einen Hoervergleich aller Optionen):
#   de_DE-thorsten-high.onnx              -> natuerlichste Qualitaet (empfohlen)
#   de_DE-thorsten-medium.onnx            -> schneller, minimal weniger natuerlich
#   de_DE-thorsten_emotional-medium.onnx  -> ausdrucksstaerkerer Tonfall
#   de_DE-pavoque-low.onnx                -> andere, dunklere Stimmfarbe
PIPER_BINARY=piper
PIPER_MODEL_PATH=./models/piper/de_DE-thorsten-high.onnx
PIPER_SPEAKER=

# --- TTS (Chatterbox Multilingual) ---
# Aktuell gewaehlte Dario-Stimme (Ergebnis mehrerer Vergleichsrunden, siehe
# voice/tts/chatterbox_tts.py). Laeuft bewusst auf CPU (MPS derzeit instabil),
# ist deutlich langsamer als Piper, klingt aber natuerlicher.
CHATTERBOX_LANGUAGE=de
CHATTERBOX_EXAGGERATION=0.22
CHATTERBOX_CFG_WEIGHT=0.35
CHATTERBOX_TEMPERATURE=0.55
CHATTERBOX_DEVICE=cpu
CHATTERBOX_MAX_ATTEMPTS=3
# Optional: eigene Referenzstimme klonen statt der Chatterbox-Standardstimme
# zu nutzen. Leer lassen fuer die Standardstimme. Wer diese Datei bereitstellt,
# muss die Rechte an der Stimme haben.
CHATTERBOX_REFERENCE_AUDIO_PATH=

# --- Asterisk / ARI ---
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_APP=dario
ASTERISK_USERNAME=dario_ari
ASTERISK_PASSWORD=change-me
ASTERISK_SIP_TRUNK=default_trunk
ASTERISK_CALLER_ID="Digital Vision <0210xxxxxxx>"

# --- SMTP E-Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=info@digitalvision-beispiel.de
SMTP_USE_TLS=true

# --- WhatsApp (optional, spaeter) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
