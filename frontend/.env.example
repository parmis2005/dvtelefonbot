# Basis-URL des Dario-Backends (FastAPI). Lokal laeuft es typischerweise auf
# Port 8000 (uvicorn app.main:app --reload). In Produktion (Vercel) auf die
# oeffentliche URL des dauerhaft laufenden Backend-Servers setzen (siehe
# CLAUDE.md "Hosting": Backend NICHT auf Vercel, da langlebige Twilio-
# Media-Stream-WebSockets nicht durch Vercel-Functions laufen koennen).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
