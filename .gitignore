.env
.venv/
venv/
__pycache__/

# Root package.json (npm run dev, siehe scripts/dev.js) hat bewusst keine
# Abhaengigkeiten - falls trotzdem "npm install" im Root ausgefuehrt wird,
# nicht versionieren (frontend/node_modules hat sein eigenes .gitignore).
/node_modules/
/package-lock.json
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# runtime data - never commit real leads/calls/secrets
data/*.db
data/*.sqlite3
data/tts_cache/
logs/*.log
transcripts/*.json
transcripts/*.txt

# keep folder structure
!data/.gitkeep
!logs/.gitkeep
!transcripts/.gitkeep

# local dashboard mirror for VS Code - contains contacts/calls/transcripts
dashboard_state/*
!dashboard_state/README.md

# models (large binaries, downloaded by setup script)
models/
*.gguf
*.bin
*.onnx

# generierte Audio-Kontrolldateien (audio_diagnostics/run_control_test.py) -
# das Skript selbst bleibt versioniert, seine WAV/Roh-Ausgaben nicht
audio_diagnostics/*.wav
audio_diagnostics/*.raw

.DS_Store
.idea/
.vscode/
